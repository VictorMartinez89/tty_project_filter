# cam_uart_win.pcf — solo los pines que el diseno realmente tiene.
#   led_r 39 / led_g 40 es el orden PROBADO. Cruzarlos hace que un diseno correcto encienda
#   rojo y manda a perseguir un problema que no existe (Parte 179).
set_io clk          35
set_io uart_tx_pin   6
set_io cam_xclk      2
set_io cam_scl      27
set_io cam_sda      26
set_io cam_pclk     28
set_io cam_href     32
set_io cam_d[0]     48
set_io cam_d[1]     46
set_io cam_d[2]     44
set_io cam_d[3]     43
set_io cam_d[4]     38
set_io cam_d[5]     34
set_io cam_d[6]     31
set_io cam_d[7]     42
set_io led_r        39
set_io led_g        40
set_io led_b        41
