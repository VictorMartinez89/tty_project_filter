<mxfile host="Claude"><diagram name="canny1_top" id="d2"><mxGraphModel dx="1900" dy="860" grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1900" pageHeight="860" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;De los pines a las cajas&lt;/b&gt; · &lt;span style='font-family:Courier New'&gt;canny1_top.v&lt;/span&gt; por dentro: tres &lt;span style='font-family:Courier New'&gt;linebuf3x3&lt;/span&gt; y la lógica entre ellas" style="text;html=1;whiteSpace=wrap;fontSize=21;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="c3" value="module canny1_top" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#555555;strokeWidth=2;fontSize=16;verticalAlign=bottom;align=right;spacingRight=14;spacingBottom=8;fontStyle=1;fontFamily=Courier New;dashed=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="1210" height="660" as="geometry"/></mxCell><mxCell id="c4" value="clk" style="rounded=0;html=1;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="320" y="150" width="120" height="26" as="geometry"/></mxCell><mxCell id="c5" value="reset" style="rounded=0;html=1;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="320" y="200" width="120" height="26" as="geometry"/></mxCell><mxCell id="c6" value="in_valid" style="rounded=0;html=1;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="320" y="262" width="120" height="26" as="geometry"/></mxCell><mxCell id="c7" value="in_pix[7:0]" style="rounded=0;html=1;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=Courier New;" vertex="1" parent