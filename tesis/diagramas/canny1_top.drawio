ck;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#6a4c93;fontColor=#6a4c93;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="690"/><mxPoint x="1430" y="690"/></Array></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.95;entryY=1;strokeColor=#888888;" edge="1" parent="1" source="c5" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="213"/><mxPoint x="460" y="740"/><mxPoint x="1505" y="740"/><mxPoint x="1505" y="650"/></Array></mxGeometry></mxCell><mxCell id="c37" value="clk llega a las tres &lt;span style='font-family:Courier New'&gt;linebuf3x3&lt;/span&gt; y al registro de salida" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="420" height="24" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Sin multiplicadores:&lt;/b&gt; sólo &lt;span style='font-family:Courier New'&gt;+&lt;/span&gt;, &lt;span style='font-family:Courier New'&gt;−&lt;/span&gt;, &lt;span style='font-family:Courier New'&gt;&amp;lt;&amp;lt;&lt;/span&gt; y comparaciones. Las cajas moradas son las &lt;b&gt;tres instancias del mismo&lt;/b&gt; &lt;span style='font-family:Courier New'&gt;linebuf3x3&lt;/span&gt; —dos filas guardadas cada una—; la de clases guarda &lt;b&gt;2 bits&lt;/b&gt; por píxel. Las líneas moradas discontinuas son la cadena de validez: &lt;span style='font-family:Courier New'&gt;in_valid → vg → vs → vc → out_valid&lt;/span&gt;." style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1800" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>