eometry x="770" y="240" width="220" height="120" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;linebuf3x3 LBS&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Courier New;font-size:11px'&gt;W=60 · DW=8&lt;/span&gt;&lt;br&gt;ventana de 3×3 de gout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece6f7;strokeColor=#6a4c93;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1050" y="240" width="200" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Sobel&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Courier New;font-size:11px'&gt;agx=|gxp−gxn|  agy=|gyp−gyn|&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:Courier New;font-size:11px'&gt;mag = sat255(agx+agy)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1290" y="240" width="260" height="120" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Doble umbral&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Courier New;font-size:11px'&gt;cls_in = mag&amp;gt;thr_hi ? 2&lt;br&gt;: mag&amp;gt;thr_lo ? 1 : 0&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="520" width="210" height="120" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;linebuf3x3 LBC&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Courier New;font-size:11px'&gt;W=60 · DW=2&lt;/span&gt;&lt;br&gt;ventana de 3×3 de clases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece6f7;strokeColor=#6a4c93;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="520" width="200" height="120" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Histéresis de un salto&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Courier New;font-size:11px'&gt;any_strong = algún vecino == 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:Courier New;font-size:11px'&gt;edge_1hop = cw11==2 