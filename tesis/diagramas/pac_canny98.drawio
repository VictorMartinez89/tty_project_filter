<mxfile host="Claude"><diagram name="pac_canny98" id="pac_canny98"><mxGraphModel dx="1900" dy="900" grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;De los pines a las cajas: mnist_top98, el reconocedor Canny-98&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#666666'&gt;Píxel → Canny de un salto → 128 contadores → trasvase → 168 rasgos → capa oculta de 120 neuronas → capa de salida → 0..9. Pesos en BRAM, activaciones en SPRAM: 98,45 %, 10 000 / 10 000 en la tarjeta.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=19;fontFamily=Helvetica;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1700" height="56" as="geometry"/></mxCell><mxCell id="c3" value="module mnist_top98   —   mnist_top98.v" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#2f4f8f;fillColor=#fbfcfe;strokeColor=#2f4f8f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="1400" height="640" as="geometry"/></mxCell><mxCell id="c4" value="un solo reloj:  clk" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#4a7ebb;fillColor=#eef4fb;strokeColor=#4a7ebb;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="142" width="1340" height="572" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:13px'&gt;Entrada&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;clk · reset&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;in_valid&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;in_pix[7:0]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;thr_hi[7:0] = 90&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;thr_lo[7:0] = 32&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dff0d8;strokeColor=#4a8a3f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="170" height="230" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;Veredicto&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;done&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;digito[3:0]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;valido&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dff0d8;strokeColor=#4a8a3f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1700" y="330" width="175" height="120" as="geometry"/></mxCell><mxCell id="c7" value="mnist_feat16_mem   ext" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#c0392b;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="305" y="180" width="330" height="500" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:13px'&gt;El extractor de Canny-78&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;Canny de un salto, octante y zona&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;tres linebuf3x3&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;sin un cambio&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="325" y="225" width="290" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:13px'&gt;128 contadores&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;16 zonas × 8 octantes&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;en memoria síncrona&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fff3cd;strokeColor=#b8860b;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="325" y="380" width="290" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:13px'&gt;frame_done · n_bordes&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="325" y="520" width="290" height="60" as="geometry"/></mxCell><mxCell id="c11" value="borde → cuenta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b style='font-size:13px'&gt;Trasvase&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;128 lecturas&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;rd_clr vacía&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;cada contador&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;130 ciclos&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e8f0fb;strokeColor=#1f4e79;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="665" y="330" width="190" height="170" as="geometry"/></mxCell><mxCell id="c14" value="mnist_clf98   clf" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#c0392b;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="885" y="180" width="710" height="500" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style='font-size:13px'&gt;fmem: 168 rasgos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;0..127 nivel 2 · 128..159 nivel 1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;160..167 nivel 0 (derivados)&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fff3cd;strokeColor=#b8860b;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="905" y="225" width="300" height="110" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style='font-size:13px'&gt;Capa oculta · 120 neuronas&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;acc = b1[j] + suma W1[j][k] · f[k]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;h[j] = min(255, max(0, acc ≫ 2))&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;una MAC por ciclo: 120 × 171 ciclos&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="905" y="375" width="300" height="150" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style='font-size:13px'&gt;Capa de salida · argmax&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;s[c] = b2[c] + suma W2[c][j] · h[j]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;10 × 123 ciclos · el índice más bajo gana&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="905" y="555" width="300" height="105" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style='font-size:13px'&gt;wmem: 21 360 pesos de 4 bits&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;W1 en j·168 + k  ·  W2 en 20 160 + c·120 + j&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;21 bloques SB_RAM40_4K&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;inicializados desde canny98_w.hex&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fff3cd;strokeColor=#b8860b;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1250" y="225" width="320" height="150" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style='font-size:13px'&gt;SB_SPRAM256KA  ·  h[0..119]&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;las 120 activaciones de 8 bits&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;no necesita inicializarse&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fdf3e8;strokeColor=#c47f2a;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1250" y="420" width="320" height="105" as="geometry"/></mxCell><mxCell id="c20" value="in_valid, in_pix,&lt;br&gt;thr_hi, thr_lo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.3;entryX=0;entryY=0.4;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="369"/><mxPoint x="270" y="277"/></Array></mxGeometry></mxCell><mxCell id="c21" value="frame_done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.5;entryX=0.3;entryY=1;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="722" y="550"/></Array></mxGeometry></mxCell><mxCell id="c22" value="rd_a / rd_d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="wr_en, wr_addr,&lt;br&gt;wr_data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="381"/><mxPoint x="870" y="280"/></Array></mxGeometry></mxCell><mxCell id="c24" value="f[k]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="W1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0;exitY=0.6;entryX=1;entryY=0.3;" edge="1" parent="1" source="c18" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1222" y="315"/><mxPoint x="1222" y="420"/></Array></mxGeometry></mxCell><mxCell id="c27" value="W2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0;exitY=0.85;entryX=1;entryY=0.4;" edge="1" parent="1" source="c18" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1236" y="352"/><mxPoint x="1236" y="597"/></Array></mxGeometry></mxCell><mxCell id="c28" value="h8, escribe_h" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="h[j]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0.5;exitY=1;entryX=1;entryY=0.8;" edge="1" parent="1" source="c19" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="639"/></Array></mxGeometry></mxCell><mxCell id="c30" value="n_bordes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="c10" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="700"/><mxPoint x="1055" y="700"/></Array></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="c17" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1630" y="576"/><mxPoint x="1630" y="390"/></Array></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;Los puertos de mnist_top98&lt;/b&gt;&lt;br&gt;in      clk,  reset,  in_valid,  in_pix[7:0],  thr_hi[7:0],  thr_lo[7:0]&lt;br&gt;out     done,  digito[3:0],  valido&lt;br&gt;Los mismos que mnist_top78: en la tarjeta se cambió sólo el clasificador, y el puerto serie o la cámara quedan igual.&lt;br&gt;&lt;b&gt;Todo el chip en la iCE40UP5K:&lt;/b&gt; 2 380 celdas lógicas (45 %) · 30 / 30 BRAM · 1 / 4 SPRAM · 17,76 MHz · 21 992 ciclos por imagen" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=11;fontColor=#555555;fillColor=#ffffff;strokeColor=#aaaaaa;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1100" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>