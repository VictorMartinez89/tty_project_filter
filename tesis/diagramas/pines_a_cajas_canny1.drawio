p;25&lt;br&gt;set_io tft_dc&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;23&lt;br&gt;set_io led_r&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 39&lt;br&gt;set_io led_g&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 40&lt;br&gt;set_io led_b&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 41" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=13;fillColor=#fdfdfd;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="1500" y="90" width="390" height="400" as="geometry"/></mxCell><mxCell id="c110" value="Sin computador de por medio: el píxel entra por los pines de la cámara y sale por los de la pantalla sin pasar por un procesador ni por el PC; el USB sólo alimenta la tarjeta y la programa. Cada cuadro azul es un pin de la iCE40 con su número del &lt;i&gt;.pcf&lt;/i&gt;, y cada línea lleva el nombre del puerto del Verilog." style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="955" width="1860" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>