<mxfile host="Claude"><diagram name="pac_trans" id="pac_trans"><mxGraphModel dx="1900" dy="900" grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;De los pines a las cajas: iCESugar iCE40UP5K + Canny transitivo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#666666'&gt;Cámara OV7670 → Gaussiano → Sobel → doble umbral → cuadro de clases → motor a punto fijo → pantalla ILI9341. Sin computador de por medio.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=19;fontFamily=Helvetica;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="56" as="geometry"/></mxCell><mxCell id="c3" value="module top   —   cam_trans_display.v" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#2f4f8f;fillColor=#fbfcfe;strokeColor=#2f4f8f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="1400" height="640" as="geometry"/></mxCell><mxCell id="c4" value="dominio  clk" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#4a7ebb;fillColor=#eef4fb;strokeColor=#4a7ebb;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="142" width="1340" height="210" as="geometry"/></mxCell><mxCell id="c5" value="dominio  cam_pclk" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#c47f2a;fillColor=#fdf3e8;strokeColor=#c47f2a;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="452" width="1340" height="262" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;clk&lt;/b&gt;&lt;br&