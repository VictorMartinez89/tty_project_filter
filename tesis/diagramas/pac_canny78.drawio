<mxfile host="Claude"><diagram name="pac_canny78" id="pac_canny78"><mxGraphModel dx="1900" dy="900" grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;De los pines a las cajas: mnist_top78, el reconocedor Canny-78&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#666666'&gt;Píxel → Canny de un salto → 16 zonas × 8 octantes en memoria → trasvase → clasificador de 78 rasgos, dos clases por pasada → 0..9 o NADA. El mismo RTL en la tarjeta y en silicio.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=19;fontFamily=Helvetica;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1700" height="56" as="geometry"/></mxCell><mxCell id="c3" value="module mnist_top78   —   mnist_top78.v" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#2f4f8f;fillColor=#fbfcfe;strokeColor=#2f4f8f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="1400" height="640" as="geometry"/></mxCell><mxCell id="c4" value="un solo reloj:  clk" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#4a7ebb;fillColor=#eef4fb;strokeColor=#4a7ebb;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="142" width="1340" height="572" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:13px'&gt;Entrada&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;clk · reset&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;in_valid&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;in_pix[7:0]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;thr_hi[7:0] = 90&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;thr_lo[7:0] = 32&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dff0d8;strokeColor=#4a8a3f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="170" height="230" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;Veredicto&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;done&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;digito[3:0]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;valido (0 = NADA)&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dff0d8;strokeColor=#4a8a3f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1700" y="330" width="175" height="120" as="geometry"/></mxCell><mxCell id="c7" value="mnist_feat16_mem   ext" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#c0392b;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="305" y="180" width="420" height="500" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:13px'&gt;Canny de un salto&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;Gaussiano → Sobel → doble umbral&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;→ histéresis, tres linebuf3x3&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="370" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:13px'&gt;Octante y zona&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;{sgn Gy, sgn Gx, |Gy| &amp;gt; |Gx|}&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;rejilla de 4 × 4 zonas sobre 28 × 28&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="355" width="370" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:13px'&gt;128 contadores en memoria síncrona&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;16 zonas × 8 octantes × 9 bits&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;leer uno cuesta 17 LUT, no 1 323&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;borrado secuencial, un solo puerto&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fff3cd;strokeColor=#b8860b;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="370" height="110" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:13px'&gt;frame_done · n_bordes&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="600" width="370" height="60" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="borde → cuenta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b style='font-size:13px'&gt;Trasvase&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;ts: T_IDLE → T_COPIA → T_ARR&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;128 lecturas encadenadas:&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;rd_a → rd_d → wr_addr&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;rd_clr vacía cada contador&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;130 ciclos; reanuda el extractor&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e8f0fb;strokeColor=#1f4e79;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="765" y="330" width="330" height="200" as="geometry"/></mxCell><mxCell id="c16" value="mnist_clf78_x2   clf" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#c0392b;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="180" width="460" height="500" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style='font-size:13px'&gt;fmem: las 168 características&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;0..127   nivel 2: los contadores&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;128..159   nivel 1: sumas de 4 zonas&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;160..167   nivel 0: sumas de 16 zonas&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fff3cd;strokeColor=#b8860b;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1155" y="220" width="410" height="120" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style='font-size:13px'&gt;78 rasgos elegidos · 780 pesos de 4 bits&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;dos clases por pasada: una lectura del rasgo,&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;los dos pesos en la misma palabra de 8 bits&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1155" y="365" width="410" height="120" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style='font-size:13px'&gt;argmax y regla de rechazo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;el mejor contra el segundo: margen&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;densidad de bordes plausible&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;si falla → valido = 0 (NADA)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;647 ciclos + 130 del trasvase = 777 &amp;lt; 784&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1155" y="510" width="410" height="130" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="in_valid, in_pix,&lt;br&gt;thr_hi, thr_lo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="369"/><mxPoint x="270" y="275"/></Array></mxGeometry></mxCell><mxCell id="c23" value="frame_done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.5;entryX=0.3;entryY=1;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="864" y="630"/></Array></mxGeometry></mxCell><mxCell id="c24" value="rd_a / rd_d, rd_clr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.3;entryX=0;entryY=0.6;" edge="1" parent="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="wr_en, wr_addr, wr_data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="arranca" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="c15" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="n_bordes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="c11" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="515" y="700"/><mxPoint x="1360" y="700"/></Array></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c19" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1640" y="549"/><mxPoint x="1640" y="390"/></Array></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Los puertos de mnist_top78&lt;/b&gt;&lt;br&gt;in      clk,  reset,  in_valid,  in_pix[7:0],  thr_hi[7:0],  thr_lo[7:0]&lt;br&gt;out     done,  digito[3:0],  valido&lt;br&gt;El mismo fichero va a la tarjeta (con el puerto serie o con la cámara y la pantalla alrededor) y a sky130." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=11;fontColor=#555555;fillColor=#ffffff;strokeColor=#aaaaaa;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1100" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>