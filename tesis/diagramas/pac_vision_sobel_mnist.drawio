<mxfile host="Claude"><diagram name="pac_vision_sobel_mnist" id="pac_vision_sobel_mnist"><mxGraphModel dx="1900" dy="900" grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;De los pines a las cajas: vision_sobel_mnist, el chip que ve, reconoce y muestra&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#666666'&gt;Cámara OV7670 → ventana de 28×28 → clasificador → pantalla ILI9341 con la ventana ampliada, el marco verde y el dígito en siete segmentos. Sin computador de por medio.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=19;fontFamily=Helvetica;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1700" height="56" as="geometry"/></mxCell><mxCell id="c3" value="module vision_sobel_mnist   —   vision_sobel_mnist.v" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#2f4f8f;fillColor=#fbfcfe;strokeColor=#2f4f8f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="1400" height="640" as="geometry"/></mxCell><mxCell id="c4" value="dominio  clk" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#4a7ebb;fillColor=#eef4fb;strokeColor=#4a7ebb;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="142" width="1340" height="210" as="geometry"/></mxCell><mxCell id="c5" value="dominio  cam_pclk" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#c47f2a;fillColor=#fdf3e8;strokeColor=#c47f2a;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="452" width="1340" height="262" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;clk · rst_n&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;reloj del sistema&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ebebeb;strokeColor=#666666;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="165" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:13px'&gt;Cámara OV7670&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;módulo externo&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dff0d8;strokeColor=#4a8a3f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="165" height="140" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:13px'&gt;Pantalla TFT&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;ILI9341&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dff0d8;strokeColor=#4a8a3f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1700" y="195" width="175" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:13px'&gt;Estado&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;cfg_done · hubo&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;digito[3:0]&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dff0d8;strokeColor=#4a8a3f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1700" y="395" width="175" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:13px'&gt;Configuración SCCB&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;COM7, COM8, COM9&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;cam_sda_o / _oe&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="195" width="200" height="110" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:13px'&gt;Sincronizador&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;dig_s1 → dig_clk&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;hubo_s1 → hubo_clk&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;2 biestables&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fff3cd;strokeColor=#b8860b;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="195" width="190" height="110" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style='font-size:13px'&gt;Controlador ILI9341&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;filas 0-223: 28×28 ampliada ×8&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;marco verde de 3 píxeles&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;filas 232-319: el dígito&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;glifo de siete segmentos (glifo.v)&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="185" width="290" height="130" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style='font-size:13px'&gt;fb[0:783]   ·   28 × 28 × 8 bits&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;escribe @cam_pclk (w_pix)   ·   lee @clk   —   CRUCE DE DOMINIOS&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fff3cd;strokeColor=#b8860b;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="370" width="520" height="64" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style='font-size:13px'&gt;Captura de la luma&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;parity: el 2.º byte de U Y V Y&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;curY, py_valid&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="305" y="505" width="230" height="160" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style='font-size:13px'&gt;cam_win28   WIN&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;ventana central 448 × 448&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;→ 28 × 28, promedio&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;invertir = 1&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="565" y="505" width="230" height="160" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style='font-size:13px'&gt;mnist_top   CLF&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;extractor + clasificador&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;de 40 rasgos, verificado&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;bit a bit contra el modelo&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;umbral cableado: 60&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="825" y="505" width="290" height="160" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style='font-size:13px'&gt;dig_pclk · hubo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;el último veredicto&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;NADA → código 10&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;(el glifo dibuja una raya)&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1145" y="505" width="200" height="160" as="geometry"/></mxCell><mxCell id="c18" value="clk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="cam_xclk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="cam_scl&lt;br&gt;cam_sda_o / _oe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0;exitY=0.8;entryX=1;entryY=0.15;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="c10" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="283"/><mxPoint x="230" y="541"/></Array></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" pare