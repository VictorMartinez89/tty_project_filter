44444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0.5;exitY=0;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="655" y="165"/><mxPoint x="1890" y="165"/><mxPoint x="1890" y="440"/></Array></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;Los puertos de vision_sobel_mnist&lt;/b&gt;&lt;br&gt;in      clk,  rst_n,  cam_pclk,  cam_href,  cam_d[7:0]&lt;br&gt;out     cam_xclk,  cam_scl,  cam_sda_o,  cam_sda_oe,  tft_sck,  tft_mosi,  tft_cs,  tft_dc,  cfg_done,  hubo,  digito[3:0]&lt;br&gt;En silicio son pads del anillo de E/S; SIOD se parte en dato y habilitación y el triestado lo hace el pad." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=11;fontColor=#555555;fillColor=#ffffff;strokeColor=#aaaaaa;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1100" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>