<mxfile host="Claude"><diagram name="pac_pan_canny" id="pac_pan_canny"><mxGraphModel dx="1900" dy="900" grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;De los pines a las cajas: pan_canny, el reconocedor con procesador&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#666666'&gt;Cámara OV7670 → ventana central de 28×28 → SoC Femto (el umbral lo escribe el programa) → bordes por zona y orientación → clasificador → 0..9 o NADA. Sin framebuffer y sin pantalla.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=19;fontFamily=Helvetica;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1700" height="56" as="geometry"/></mxCell><mxCell id="c3" value="module pan_canny   —   pan_canny.v" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#2f4f8f;fillColor=#fbfcfe;strokeColor=#2f4f8f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="1400" height="640" as="geometry"/></mxCell><mxCell id="c4" value="un solo reloj:  pclk, el reloj de píxel de la cámara" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#4a7ebb;fillColor=#eef4fb;strokeColor=#4a7ebb;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="142" width="1340" height="572" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:13px'&gt;Cámara OV7670&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;fuera del chip&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;pclk · href · sync&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;pix_y[7:0] · pix_valid&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;(la luma ya extraída)&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dff0d8;strokeColor=#4a8a3f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="170" height="200" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;cam_win28   WIN&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;ventana central 448 × 448&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;bloques de 16 × 16 → 28 × 28&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;promedio: suma &amp;gt;&amp;gt; 8&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;invertir = 1 (trazo claro)&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="305" y="440" width="215" height="200" as="geometry"/></mxCell><mxCell id="c7" value="soc_mnist_canny_fw_top   CLF" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#2f4f8f;fillColor=#ffffff;strokeColor=#2f4f8f;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="180" width="1050" height="510" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:13px'&gt;soc_ctrl   SOC&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;FemtoRV32 + ROM de 7 instrucciones&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;peripheral_filter en 0x0045&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;el programa escribe 0x5A20&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;→ thr_hi = 90, thr_lo = 32&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e8f0fb;strokeColor=#1f4e79;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="580" y="225" width="330" height="150" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:13px'&gt;mnist_feat_canny   FEAT&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;Gaussiano → Sobel → doble umbral&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;→ histéresis de un salto&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;{octante, clase} en 5 bits&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;por la tercera ventana&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;= 32 contadores de 9 bits&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="580" y="450" width="330" height="210" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:13px'&gt;mnist_clf_canny_fw   CLF&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;40 rasgos: 32 + 8 derivados&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;pesos entrenados con el Canny&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;una MAC por ciclo, argmax&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;NADA si bordes ∉ [174, 376]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;o margen &amp;lt; 70&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1000" y="450" width="330" height="210" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:13px'&gt;Veredicto&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;done · digito[3:0]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;valido (0 = NADA)&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dff0d8;strokeColor=#4a8a3f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1700" y="470" width="175" height="110" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style='font-size:13px'&gt;Observabilidad&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;thr_hi_o · thr_lo_o&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;cpu_escribio&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dff0d8;strokeColor=#4a8a3f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1700" y="250" width="175" height="100" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="w_valid, w_pix" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="umbral" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="32 contadores&lt;br&gt;n_bordes · frame_done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="clr ← done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="c10" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1165" y="700"/><mxPoint x="745" y="700"/></Array></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Los puertos de pan_canny&lt;/b&gt;&lt;br&gt;in      pclk,  reset,  href,  sync,  pix_y[7:0],  pix_valid&lt;br&gt;out     done,  digito[3:0],  valido,  thr_hi_o,  thr_lo_o,  cpu_escribio&lt;br&gt;En silicio son pads del anillo de E/S. No hay .pcf ni segundo reloj: todo corre al ritmo de la cámara." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=11;fontColor=#555555;fillColor=#ffffff;strokeColor=#aaaaaa;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1100" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>