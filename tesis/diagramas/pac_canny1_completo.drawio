<mxfile host="Claude"><diagram name="pac_canny1_completo" id="pac_canny1_completo"><mxGraphModel dx="1900" dy="900" grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;De los pines a las cajas: canny1_completo, la cadena del Canny de un salto para silicio&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#666666'&gt;Cámara OV7670 → gris → Gaussiano 3×3 → Sobel 3×3 → doble umbral → histéresis → framebuffer de 1 bit → pantalla ILI9341. Sin computador de por medio.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=19;fontFamily=Helvetica;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1600" height="56" as="geometry"/></mxCell><mxCell id="c3" value="module canny1_completo   —   canny1_completo.v" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#2f4f8f;fillColor=#fbfcfe;strokeColor=#2f4f8f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="1400" height="640" as="geometry"/></mxCell><mxCell id="c4" value="un solo reloj:  clk   (la cámara entra por 2 biestables de sincronización)" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#4a7ebb;fillColor=#eef4fb;strokeColor=#4a7ebb;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="142" width="1340" height="572" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:13px'&gt;clk · rst_n&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;reloj del sistema&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;reinicio asíncrono&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ebebeb;strokeColor=#666666;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="165" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;Cámara OV7670&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;módulo externo&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dff0d8;strokeColor=#4a8a3f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="165" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:13px'&gt;Pantalla TFT&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;ILI9341&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dff0d8;strokeColor=#4a8a3f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1700" y="500" width="175" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:13px'&gt;Estado&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;cfg_done ← ov7670_sccb&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;init_done ← lcd_ili9341_top&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dff0d8;strokeColor=#4a8a3f;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1700" y="190" width="175" height="80" as="geometry"/></mxCell><mxCell id="c9" value="cam_frontend_top   u_fe" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#2f4f8f;fillColor=#ffffff;strokeColor=#2f4f8f;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="180" width="580" height="210" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:13px'&gt;ov7670_sccb&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;configura la cámara&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;al arrancar&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;SIOD: dato + enable&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="315" y="215" width="165" height="150" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:13px'&gt;ov7670_capture&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;genera cam_xclk&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;PCLK/HREF/VSYNC → 2-FF&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;2 bytes → RGB565&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="495" y="215" width="185" height="150" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style='font-size:13px'&gt;rgb565_to_gray&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;Y = (R + 2G + B) &amp;gt;&amp;gt; 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;sin multiplicar&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;gray, gray_valid&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="695" y="215" width="170" height="150" as="geometry"/></mxCell><mxCell id="c13" value="cam_sioc&lt;br&gt;cam_siod_o / _oe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0;exitY=0.85;entryX=1;entryY=0.2;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="c10" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="343"/><mxPoint x="240" y="360"/></Array></mxGeometry></mxCell><mxCell id="c14" value="cam_d[7:0] · cam_pclk&lt;br&gt;cam_href · cam_vsync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.45;entryX=0.62;entryY=1;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="397"/></Array></mxGeometry></mxCell><mxCell id="c15" value="cam_xclk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0.8;exitY=1;entryX=1;entryY=0.83;" edge="1" parent="1" source="c11" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="643" y="455"/></Array></mxGeometry></mxCell><mxCell id="c16" value="px565" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="clk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="225"/><mxPoint x="260" y="245"/></Array></mxGeometry></mxCell><mxCell id="c18" value="&lt;b style='font-size:13px'&gt;canny1_top   u_can&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;Gaussiano 3×3 → Sobel 3×3&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;→ doble umbral 90 / 40&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;→ histéresis de un salto&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;tres linebuf3x3 (LBG, LBS, LBC)&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="215" width="330" height="150" as="geometry"/></mxCell><mxCell id="c19" value="gray, gray_valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;" edge="1" parent="1" source="c12" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b style='font-size:13px'&gt;fb[0:4799]   ·   60 × 80&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;1 bit por píxel&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;fb[wadr] ← can_p[7]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;4 800 biestables, no 38 400&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;frame_start → wadr = 0&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fff3cd;strokeColor=#b8860b;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="500" width="240" height="150" as="geometry"/></mxCell><mxCell id="c21" value="can_v, can_p" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0.3;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b style='font-size:13px'&gt;Lectura para la pantalla&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;xcol, ycol  (240 × 320)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;fx = xcol / 4, fy = ycol / 4&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;raddr = fy·60 + fx&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;fb_rd_bit → 0xFF / 0x00&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="500" width="200" height="150" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style='font-size:13px'&gt;lcd_ili9341_top   u_lcd&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;shifter SPI, modo 0&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;ROM de comandos INIT y FRAME&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;BOOT → INIT → FRAME → FILL&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;gris → RGB565&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#777777'&gt;240 × 320 píxeles&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="480" width="260" height="190" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="pix_gray = fb_rd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="pix_next, frame_start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="c23" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="tft_sck · tft_mosi&lt;br&gt;tft_cs · tft_dc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c23" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="init_done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;endSize=8;exitX=0.5;exitY=0;entryX=0;entryY=0.8;dashed=1;" edge="1" parent="1" source="c23" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1470" y="254"/></Array></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Los 18 puertos de canny1_completo&lt;/b&gt;&lt;br&gt;in      clk,  rst_n,  cam_d[7:0],  cam_pclk,  cam_href,  cam_vsync&lt;br&gt;out     cam_xclk,  cam_sioc,  cam_siod_o,  cam_siod_oe,  tft_sck,  tft_mosi,  tft_cs,  tft_dc,  cfg_done,  init_done&lt;br&gt;En silicio no hay .pcf: cada puerto es un pad del anillo de E/S. SIOD se parte en dato y habilitación, y el triestado lo hace el pad." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=11;fontColor=#555555;fillColor=#ffffff;strokeColor=#aaaaaa;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1100" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>